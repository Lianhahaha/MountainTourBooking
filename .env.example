# Supabase (required for production)
# Create a project at https://supabase.com, run supabase/schema.sql in the SQL
# editor, then paste the project URL and service role key here.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public key, only needed if the browser talks to Supabase directly (it does not today)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend email (optional — booking notifications and approvals)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
OWNER_EMAIL=hello@tiklingapo.ph

# Owner dashboard password. Generate a long random value for production.
ADMIN_PASSWORD=change-me

# Absolute site URL, used for canonical links, sitemap, and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://apotour.vercel.app
