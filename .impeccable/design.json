  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Main action: book, send, confirm.",
      "html": "<a class=\"ds-btn-cta\" href=\"#\">Book this date <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></a>",
      "css": ".ds-btn-cta{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:40px;padding:10px 20px;border-radius:6px;background:var(--primary);color:var(--primary-foreground);font-family:var(--font-sans);font-size:14px;font-weight:600;text-decoration:none;transition:background-color .15s}.ds-btn-cta:hover{background:var(--primary-hover)}.ds-btn-cta:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Small Primary Button",
      "kind": "button",
      "refersTo": "button-primary-sm",
      "description": "Header, date-row and sticky-bar Book button.",
      "html": "<a class=\"ds-btn-cta-sm\" href=\"#\">Book a climb</a>",
      "css": ".ds-btn-cta-sm{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:36px;padding:6px 14px;border-radius:6px;background:var(--primary);color:var(--primary-foreground);font-family:var(--font-sans);font-size:14px;font-weight:600;text-decoration:none;transition:background-color .15s}.ds-btn-cta-sm:hover{background:var(--primary-hover)}.ds-btn-cta-sm:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Alternative action such as requesting a private climb.",
      "html": "<a class=\"ds-btn-secondary\" href=\"#\">Request a private climb</a>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:40px;padding:10px 20px;border-radius:6px;border:1px solid var(--border);background:var(--surface-elevated);color:var(--foreground);font-family:var(--font-sans);font-size:14px;font-weight:600;text-decoration:none;transition:border-color .15s}.ds-btn-secondary:hover{border-color:var(--muted)}.ds-btn-secondary:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Box with Header",
      "kind": "card",
      "refersTo": "box",
      "description": "GitHub Box: canvas body, surface header row.",
      "html": "<div class=\"ds-box\"><div class=\"ds-box-header\"><span class=\"ds-box-title\">Next climb</span><span class=\"ds-box-meta\">Mt. Apo Summit</span></div><div class=\"ds-box-body\"><span class=\"ds-box-date\">Nov <span class=\"ds-success\">14</span></span>Box content sits here at 14px.</div></div>",
      "css": ".ds-box{overflow:hidden;border:1px solid var(--border);border-radius:6px;background:var(--background);color:var(--foreground);font-family:var(--font-sans);max-width:400px}.ds-box-header{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 16px;border-bottom:1px solid var(--border);background:var(--surface)}.ds-box-title{font-size:13px;font-weight:600}.ds-box-meta{font-size:12px;color:var(--muted)}.ds-box-body{padding:16px 20px;font-size:14px;color:var(--muted)}.ds-box-date{display:block;margin-bottom:8px;font-family:var(--font-display);font-size:28px;font-weight:800;line-height:1;letter-spacing:-0.025em;font-variant-numeric:tabular-nums;color:var(--foreground)}.ds-success{color:var(--success)}"
    },
    {
      "name": "Section Tabs",
      "kind": "nav",
      "refersTo": "section-tab",
      "description": "GitHub underline tabs with counters; the coral underline marks the section in view.",
      "html": "<nav class=\"ds-tabs\"><a href=\"#\" class=\"ds-tab ds-tab-current\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M3 10h18M8 3v4M16 3v4\"/></svg>Dates<span class=\"ds-counter\">4</span></a><a href=\"#\" class=\"ds-tab\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M9.5 9a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.6V14M12 17h.01\"/></svg>FAQ<span class=\"ds-counter\">9</span></a></nav>",
      "css": ".ds-tabs{display:flex;gap:4px;padding:0 8px;border-bottom:1px solid var(--border);background:var(--background);font-family:var(--font-sans)}.ds-tab{position:relative;display:flex;align-items:center;gap:8px;margin:6px 0;padding:6px 10px;border-radius:6px;font-size:14px;color:var(--muted);text-decoration:none;transition:color .15s,background-color .15s}.ds-tab svg{color:var(--muted);flex-shrink:0}.ds-tab:hover{background:var(--surface);color:var(--foreground)}.ds-tab:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.ds-tab-current{font-weight:600;color:var(--foreground)}.ds-tab-current::after{content:\"\";position:absolute;left:4px;right:4px;bottom:-7px;height:2px;border-radius:9999px;background:var(--tab-active)}.ds-counter{min-width:20px;padding:0 6px;border-radius:9999px;background:color-mix(in srgb,var(--muted) 20%,transparent);font-size:12px;font-weight:500;line-height:18px;text-align:center;font-variant-numeric:tabular-nums;color:var(--foreground)}"
    },
    {
      "name": "Header Bar",
      "kind": "nav",
      "refersTo": "header-bar",
      "description": "Surface header; on the landing page only cross-page links, the theme toggle and Book.",
      "html": "<header class=\"ds-header\"><span class=\"ds-brand\"><span class=\"ds-mark\"></span>Tikling Apo Tours</span><nav class=\"ds-hnav\"><a href=\"#\" class=\"ds-hlink\">Photos</a><span class=\"ds-vrule\"></span><a href=\"#\" class=\"ds-hbook\">Book a climb</a></nav></header>",
      "css": ".ds-header{display:flex;align-items:center;justify-content:space-between;gap:12px;height:56px;padding:0 16px;border-bottom:1px solid var(--border);background:var(--surface);font-family:var(--font-sans)}.ds-brand{display:flex;align-items:center;gap:8px;font-family:var(--font-display);font-size:17px;font-weight:700;color:var(--foreground)}.ds-mark{width:28px;height:28px;border-radius:6px;background:var(--primary)}.ds-hnav{display:flex;align-items:center;gap:2px}.ds-hlink{padding:6px 10px;border-radius:6px;font-size:14px;font-weight:500;color:var(--muted);text-decoration:none;transition:color .15s,background-color .15s}.ds-hlink:hover{background:var(--background);color:var(--foreground)}.ds-hlink:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.ds-vrule{width:1px;height:20px;margin:0 6px;background:var(--border)}.ds-hbook{display:inline-flex;align-items:center;min-height:36px;padding:6px 14px;border-radius:6px;background:var(--primary);color:var(--primary-foreground);font-size:14px;font-weight:600;text-decoration:none;transition:background-color .15s}.ds-hbook:hover{background:var(--primary-hover)}.ds-hbook:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Slot Meter",
      "kind": "custom",
      "refersTo": "slot-segment",
      "description": "One segment per slot: open filled, taken hollow, words always shown.",
      "html": "<div><div class=\"ds-meter\"><span class=\"ds-seg ds-open\"></span><span class=\"ds-seg ds-open\"></span><span class=\"ds-seg ds-open\"></span><span class=\"ds-seg ds-open\"></span><span class=\"ds-seg ds-open\"></span><span class=\"ds-seg ds-taken\"></span><span class=\"ds-seg ds-taken\"></span><span class=\"ds-seg ds-taken\"></span></div><p class=\"ds-meter-label\">5 of 8 slots left</p></div>",
      "css": ".ds-meter{display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:3px;width:280px}.ds-seg{height:10px;border-radius:2px}.ds-open{background:var(--primary)}.ds-taken{box-shadow:inset 0 0 0 1.5px var(--border)}.ds-meter-label{margin:6px 0 0;font-family:var(--font-sans);font-size:13px;font-weight:600;font-variant-numeric:tabular-nums;color:var(--foreground)}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "field-input",
      "description": "Form field with its label above.",
      "html": "<label class=\"ds-label\">Your name<input class=\"ds-input\" placeholder=\"Juan Dela Cruz\"></label>",
      "css": ".ds-label{display:block;font-family:var(--font-sans);font-size:13px;font-weight:500;color:var(--foreground);max-width:320px}.ds-input{display:block;width:100%;margin-top:4px;padding:8px 12px;border:1px solid var(--border);border-radius:6px;background:var(--input-bg);color:var(--foreground);font-size:14px;caret-color:var(--primary);transition:border-color .15s,box-shadow .15s}.ds-input::placeholder{color:var(--muted)}.ds-input:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 2px color-mix(in srgb,var(--accent) 25%,transparent)}"
    },
    {
      "name": "Label Pills",
      "kind": "chip",
      "refersTo": "label-pill",
      "description": "Informational difficulty, private-group and status pills; never clickable.",
      "html": "<span class=\"ds-pill ds-easy\">Easy</span> <span class=\"ds-pill ds-hard\">Hard</span> <span class=\"ds-pill ds-private\">Private group</span> <span class=\"ds-pill ds-low\">Only 2 slots left</span>",
      "css": ".ds-pill{display:inline-flex;border-radius:9999px;padding:2px 8px;font-family:var(--font-sans);font-size:11px;font-weight:600}.ds-easy{background:var(--primary-muted);color:var(--primary)}.ds-hard{background:var(--danger-muted);color:var(--danger)}.ds-private{border:1px solid color-mix(in srgb,var(--done) 40%,transparent);background:var(--done-muted);color:var(--done);font-size:12px;font-weight:500}.ds-low{border:1px solid color-mix(in srgb,var(--warning) 40%,transparent);background:var(--warning-muted);color:var(--warning);font-size:12px}"
    }
